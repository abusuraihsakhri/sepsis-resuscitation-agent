{
  "openapi": "3.1.0",
  "info": {
    "title": "Sepsis Resuscitation Agent Demonstration API",
    "description": "Local demonstration of arbitrary numeric threshold and keyword rules. Not a clinical guideline implementation, PHI-deidentification system, or medical device.",
    "version": "2.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return demonstration counters as JSON",
        "responses": {
          "200": {
            "description": "JSON object with dossiers_processed_total, audit_blocks_total and system_status"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic data using illustrative, nonclinical rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier and signed audit-block hash"
          },
          "422": {
            "description": "Malformed input, nonfinite metric, or recognized sensitive identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query the deterministic local mock adapter (no LLM inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve process-local audit signature metadata and chain verification",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    }
  }
}
